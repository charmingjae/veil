{
  "name": "veil-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @-3-/veil build && pnpm --parallel --filter @-3-/veil --filter playground dev",
    "build": "pnpm --recursive build",
    "lint": "biome check && pnpm --recursive --if-present lint",
    "lint:fix": "biome check --write",
    "capture:textures": "pnpm build && node scripts/capture-textures.ts",
    "capture:effects": "pnpm build && node scripts/capture-effects.ts",
    "capture:og": "pnpm build && node scripts/capture-og.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "gifenc": "^1.0.3",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0"
  }
}
